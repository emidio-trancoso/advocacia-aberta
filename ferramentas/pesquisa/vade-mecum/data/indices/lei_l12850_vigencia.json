    "21-A": {
      "situacao": null,
      "eventos": [
        {
          "tipo": "inclusao",
          "unidade": "caput",
          "diploma": {
            "especie": "Lei",
            "numero": "15.245",
            "ano": 2025
          },
          "trecho": "…investigação de crimes praticados por organização criminosa ou a aprovação de qualquer medida contra o crime organizado.",
          "literal": "(Incluído pela Lei nº 15.245, de 2025)"
        },
        {
          "tipo": "inclusao",
          "unidade": "caput",
          "diploma": {
            "especie": "Lei",
            "numero": "15.245",
            "ano": 2025
          },
          "trecho": "Pena – reclusão, de 4 (quatro) a 12 (doze) anos, e multa.",
          "literal": "(Incluído pela Lei nº 15.245, de 2025)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 1º",
          "diploma": {
            "especie": "Lei",
            "numero": "15.245",
            "ano": 2025
          },
          "trecho": "…ro, filho ou parente consanguíneo até o terceiro grau, ou por afinidade, das pessoas relacionadas no caput deste artigo.",
          "literal": "(Incluído pela Lei nº 15.245, de 2025)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 2º",
          "diploma": {
            "especie": "Lei",
            "numero": "15.245",
            "ano": 2025
          },
          "trecho": "§ 2º Se a violência ou grave ameaça é tentada ou consumada, aplica-se também a pena cominada ao crime correspondente.",
          "literal": "(Incluído pela Lei nº 15.245, de 2025)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 3º",
          "diploma": {
            "especie": "Lei",
            "numero": "15.245",
            "ano": 2025
          },
          "trecho": "…o crime previsto neste artigo deverá iniciar o cumprimento da pena em estabelecimento penal federal de segurança máxima.",
          "literal": "(Incluído pela Lei nº 15.245, de 2025)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 4º",
          "diploma": {
            "especie": "Lei",
            "numero": "15.245",
            "ano": 2025
          },
          "trecho": "…tigado ou processado por crime previsto neste artigo será recolhido a estabelecimento penal federal de segurança máxima.",
          "literal": "(Incluído pela Lei nº 15.245, de 2025)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 4º",
          "diploma": {
            "especie": "Lei",
            "numero": "15.245",
            "ano": 2025
          },
          "trecho": "Conspiração para obstrução de ações contra o crime organizado",
          "literal": "(Incluído pela Lei nº 15.245, de 2025)"
        }
      ]
