            "ano": 2017
          },
          "trecho": "§ 2o (Revogado).",
          "literal": "(Redação dada pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 3º",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "§ 3o Considera-se parte relacionada à instituição financeira, para efeitos deste artigo:",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso I",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "I - seus controladores, pessoas físicas ou jurídicas, nos termos do art. 116 da Lei no 6.404, de 15 de dezembro de 1976;",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso II",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "II - seus diretores e membros de órgãos estatutários ou contratuais;",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso III",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "…o e os parentes, consanguíneos ou afins, até o segundo grau, das pessoas mencionadas nos incisos I e II deste parágrafo;",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso IV",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "IV - as pessoas físicas com participação societária qualificada em seu capital; e",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso V",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "V - as pessoas jurídicas:",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "alínea a",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "a) com participação qualificada em seu capital;",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "alínea b",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "b) em cujo capital, direta ou indiretamente, haja participação societária qualificada;",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "alínea c",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "…is haja controle operacional efetivo ou preponderância nas deliberações, independentemente da participação societária; e",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "alínea d",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "d) que possuírem diretor ou membro de conselho de administração em comum.",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 4º",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "…-se da vedação de que trata o caput deste artigo, respeitados os limites e as condições estabelecidos em regulamentação:",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso I",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "… diferenciados comparativamente às operações deferidas aos demais clientes de mesmo perfil das respectivas instituições;",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso II",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "II - as operações com empresas controladas pela União, no caso das instituições financeiras públicas federais;",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso III",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "… de subordinação, observado o disposto no inciso V do art. 10 desta Lei, no caso das instituições financeiras bancárias;",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso IV",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "IV - os depósitos interfinanceiros regulados na forma do inciso XXXII do caput do art. 4o desta Lei;",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso V",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "…os e suas respectivas contrapartes em operações conduzidas no âmbito das referidas câmaras ou prestadores de serviços; e",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso VI",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "VI - os demais casos autorizados pelo Conselho Monetário Nacional.",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 5º",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "… indireto, simulado ou mediante interposição de terceiro, com o fim de realizar operação vedada nos termos deste artigo.",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 6º",
          "diploma": {
            "especie": "Lei",
            "numero": "13.506",
            "ano": 2017
          },
          "trecho": "…plinará o disposto neste artigo, inclusive a definição de operação de crédito, de limites e de participação qualificada.",
          "literal": "(Incluído pela Lei nº 13.506, de 2017)"
        }
      ]
    },
