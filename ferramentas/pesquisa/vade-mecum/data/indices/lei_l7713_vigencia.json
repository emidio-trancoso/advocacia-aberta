        {
          "tipo": "redacao",
          "unidade": "caput",
          "diploma": {
            "especie": "Lei",
            "numero": "7.738",
            "ano": 1989
          },
          "trecho": "… alíquota de sete inteiros e cinco décimos por cento, o rendimento bruto produzido por quaisquer aplicações financeiras.",
          "literal": "(Redação dada pela Lei nº 7.738, de 1989)"
        },
        {
          "tipo": "redacao",
          "unidade": "§ 1º",
          "diploma": {
            "especie": "Lei",
            "numero": "7.738",
            "ano": 1989
          },
          "trecho": "…a-se, também, às operações de financiamento realizadas em bolsas de valores, de mercadorias, de futuros ou assemelhadas.",
          "literal": "(Redação dada pela Lei nº 7.738, de 1989)"
        },
        {
          "tipo": "redacao",
          "unidade": "§ 2º",
          "diploma": {
            "especie": "Lei",
            "numero": "7.738",
            "ano": 1989
          },
          "trecho": "§ 2º O disposto neste artigo não se aplica ao rendimento bruto auferido:",
          "literal": "(Redação dada pela Lei nº 7.738, de 1989)"
        },
        {
          "tipo": "redacao",
          "unidade": "alínea a",
          "diploma": {
            "especie": "Lei",
            "numero": "7.738",
            "ano": 1989
          },
          "trecho": "a) em aplicações em fundos de curto prazo, tributados nos termos do Decreto-Lei nº 2.458, de 25 de agosto de 1988;",
          "literal": "(Redação dada pela Lei nº 7.738, de 1989)"
        },
        {
          "tipo": "redacao",
          "unidade": "alínea b",
          "diploma": {
            "especie": "Lei",
            "numero": "7.738",
            "ano": 1989
          },
          "trecho": "…consideradas as de prazo inferior a noventa dias, que serão tributadas às seguintes alíquotas, sobre o rendimento bruto:",
          "literal": "(Redação dada pela Lei nº 7.738, de 1989)"
        },
        {
          "tipo": "redacao",
          "unidade": "alínea b",
          "diploma": {
            "especie": "Lei",
            "numero": "7.738",
            "ano": 1989
          },
          "trecho": "1. quando a operação se iniciar e encerrar no mesmo dia, quarenta por cento;",
          "literal": "(Redação dada pela Lei nº 7.738, de 1989)"
