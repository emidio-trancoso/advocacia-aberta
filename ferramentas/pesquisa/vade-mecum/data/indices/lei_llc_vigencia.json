    "184": {
      "situacao": null,
      "eventos": [
        {
          "tipo": "veto",
          "unidade": "§ 1º",
          "diploma": null,
          "trecho": "§ 1º",
          "literal": "(VETADO)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 1º",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "§ 1º (VETADO).",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 2º",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "…. 124 desta Lei, o valor global inicialmente pactuado demonstrar-se insuficiente para a execução do objeto, poderão ser:",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso I",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "I - utilizados saldos de recursos ou rendimentos de aplicação financeira;",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso II",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "II - aportados novos recursos pelo concedente;",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso III",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "III - reduzidas as metas e as etapas, desde que isso não comprometa a fruição ou a funcionalidade do objeto pactuado.",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 3º",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "…s instrumentos celebrados com recursos de transferências voluntárias, para promover alterações em seu objeto, desde que:",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso I",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "…osição, remanejamento ou transferência de recursos de uma categoria de programação para outra ou de um órgão para outro;",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso II",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "II - seja apresentada justificativa objetiva pelo convenente; e",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso III",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "III - quando se tratar de obra, seja mantido o que foi pactuado quanto a suas características.",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 4º",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "…alidade do objeto pactuado, devendo constar de demonstrativo específico que integrará as prestações de contas do ajuste.",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        }
      ]
    },
    "184-A": {
      "situacao": null,
      "eventos": [
        {
          "tipo": "inclusao",
          "unidade": "caput",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "…com valor global de até R$ 1.500.000,00 (um milhão e quinhentos mil reais), aplicar-se-á o seguinte regime simplificado:",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso I",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "I - o plano de trabalho aprovado conterá parâmetros objetivos para caracterizar o cumprimento do objeto;",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso II",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "II - a minuta dos instrumentos deverá ser simplificada;",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso III",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "III - a liberação dos recursos dar-se-á em parcela única;",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "inciso IV",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "… a verificação da execução do objeto ocorrerá mediante visita de constatação da compatibilidade com o plano de trabalho.",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 1º",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "… o marco de execução de 100% (cem por cento) do cronograma físico, podendo ocorrer outras vistorias, quando necessárias.",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 2º",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "…eto, e caberá à concedente ou mandatária verificar o cumprimento do objeto pactuado ao final da execução do instrumento.",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 3º",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "…ov constituirão condição para a liberação da parcela única dos recursos de que trata o inciso III do caput deste artigo.",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        },
        {
          "tipo": "inclusao",
          "unidade": "§ 4º",
          "diploma": {
            "especie": "Lei",
            "numero": "14.770",
            "ano": 2023
          },
          "trecho": "…e artigo aplica-se aos convênios, contratos de repasse e instrumentos congêneres celebrados após a publicação desta Lei.",
          "literal": "(Incluído pela Lei nº 14.770, de 2023)"
        }
      ]
    },
